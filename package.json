{
  "name": "bzmagnet",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm guard:public && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "guard:public": "node scripts/public-boundary-guard.mjs",
    "guard:build": "node scripts/build-output-scan.mjs",
    "report:similarity": "node scripts/content-similarity-report.mjs",
    "audit:products": "node scripts/audit-bzmagnet-products.mjs",
    "audit:news-readiness": "node scripts/audit-news-release-readiness.mjs",
    "audit:product-redirects": "node scripts/generate-product-redirect-map.mjs",
    "news:migrate": "node scripts/migrate-news-automation.mjs",
    "news:bootstrap": "node scripts/bootstrap-news-store.mjs",
    "news:sources:import": "node scripts/import-news-source-catalog.mjs",
    "admin:migrate": "node scripts/migrate-admin-operating-layer.mjs",
    "admin:seed-catalog": "node scripts/seed-admin-catalog.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "typescript": "5.7.2"
  }
}
