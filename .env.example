NEXT_PUBLIC_SITE_ORIGIN=https://bzmagnet.com
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
# pbkdf2-sha256$<iterations>$<base64url-salt>$<hex-derived-key>
ADMIN_PASSWORD_HASH=
ADMIN_DATA_STORE_URL=
ADMIN_DATA_STORE_TOKEN=
ADMIN_DEMO_MODE=false
ADMIN_AUDIT_RETENTION_DAYS=365
# Optional override. With no external provider, the existing Neon DATABASE_URL is used.
ADMIN_DATABASE_URL=
ANALYTICS_CONNECTION_URL=
# Google Search Console service account values are server-only. Never prefix either value with NEXT_PUBLIC_.
SEARCH_CONSOLE_SITE_URL=sc-domain:bzmagnet.com
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
CRM_CONNECTION_URL=
# Inquiries are stored in the site-scoped Neon table by default. Do not expose this key.
INQUIRY_ENCRYPTION_KEY=
BZMAGNET_EMAIL_FROM=
BZMAGNET_EMAIL_TO=
BZMAGNET_PUBLIC_EMAIL=
BZMAGNET_PUBLIC_PHONE=
BZMAGNET_PUBLIC_ADDRESS=
RATE_LIMIT_STORE_URL=
RATE_LIMIT_STORE_TOKEN=
CRON_SECRET=
# Default is internal_review: no external feed, generator, sitemap or analytics provider is called.
# Set external_sources only after verified sources and a reviewed generator have been deliberately configured.
NEWS_AUTOMATION_MODE=internal_review
# Durable PostgreSQL storage for News candidates, articles, locks and audit runs.
NEWS_DATABASE_URL=
# A Vercel Marketplace Neon connection normally injects DATABASE_URL automatically.
DATABASE_URL=
# JSON array of trusted HTTPS RSS/Atom feeds: [{"id":"...","publisher":"...","url":"https://...","highTrust":true,"licenseNote":"..."}]
NEWS_SOURCE_FEEDS=[]
# Private structured-content generator. It must return an Article JSON object and must never publish directly.
NEWS_GENERATOR_WEBHOOK_URL=
NEWS_GENERATOR_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITEMAP_WEBHOOK_URL=
GOOGLE_SEARCH_CONSOLE_SITEMAP_WEBHOOK_TOKEN=
# The Vercel cron is 01:00 UTC (= 09:00 Asia/Shanghai); the database enforces at least 48 hours between successful News publications.
NEWS_AUTOMATION_TIMEZONE=Asia/Shanghai
